{
  "name": "@danielaglint/custom-web-components",
  "version": "1.0.0",
  "keywords": [
    "web-components",
    "react",
    "library"
  ],
  "author": "Daniela Glint",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/danaonel/custom-web-components-design-system.git"
  },
  "files": [
    "dist"
  ],
  "description": "Web Components library with React wrapper",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css",
    "./src/core/register-auto.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./register": {
      "import": "./dist/register.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "scripts": {
    "build": "npm run clean && npm run build:bundle && npm run build:types",
    "clean": "rm -rf dist",
    "build:types": "tsc --emitDeclarationOnly --outDir dist",
    "build:bundle": "vite build",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "release": "npm run build && changeset publish"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@chromatic-com/storybook": "latest",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/addon-vitest": "^10.6.2",
    "@storybook/web-components-vite": "^10.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest",
    "lit": "latest",
    "playwright": "latest",
    "publint": "^0.3.25",
    "storybook": "^10.6.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "latest"
  },
  "engines": {
    "node": ">=20"
  }
}
